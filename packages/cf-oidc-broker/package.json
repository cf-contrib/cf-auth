{
  "name": "cf-oidc-broker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=esm --platform=neutral --main-fields=module,main --conditions=workerd,worker,browser --target=es2024 --external:./policy.json --outfile=dist/broker.js",
    "check:bundle": "vitest run -c vitest.bundle.config.ts && node -e \"const n=require('node:zlib').gzipSync(require('node:fs').readFileSync('dist/broker.js')).length;console.log('broker.js gzip: '+n+' bytes');if(n>256*1024){console.error('bundle exceeds 256 KiB gzipped');process.exit(1)}\"",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cloudflare": "^7.2.0",
    "jose": "^6.2.12",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260901.0",
    "@octokit/openapi-types": "^29.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.140.0"
  }
}
